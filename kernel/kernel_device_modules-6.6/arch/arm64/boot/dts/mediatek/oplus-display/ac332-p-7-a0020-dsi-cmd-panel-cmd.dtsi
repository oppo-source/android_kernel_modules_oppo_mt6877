					39 00 00 40 00 00 04 FF 5A A5 08
					39 00 00 40 00 00 02 B0 00
					39 00 00 00 00 00 04 FF 5A A5 00

					15 00 00 00 14 00 02 29 00
				];
				oplus,dsi-aod-off-command = [
					39 00 00 40 00 00 04 FF 5A A5 08
					15 00 00 40 00 00 02 98 02
					39 00 00 40 00 00 04 FF 5A A5 4F
					15 00 00 40 00 00 02 80 01
					15 00 00 40 00 00 02 81 06
					15 00 00 40 00 00 02 88 78
					39 00 00 40 00 00 04 FF 5A A5 02
					39 00 00 40 00 00 03 84 01 05
					39 00 00 40 00 00 04 FF 5A A5 00
					15 00 00 40 00 00 02 38 00
					39 00 00 40 00 00 04 FF 5A A5 08
