#include <dt-bindings/pinctrl/mt6373-pinfunc.h>

&afe {
    etdm-out-ch = <2 2 2 2 8 16 2>;
    etdm-in-ch = <2 2 2 2 8 16 16>;
    etdm-in-format = <0 0 0 0 5 0 0>;
    etdm-out-format = <0 0 0 0 5 0 0>;
    use-tdm-protocol = <1>;
    pad-top-value = <4>;
};


&snd_audio_dsp {
    mtk-dsp-playback = <0x1 0xe 0xffffffff 0x24 0x30000>;
    mtk-dsp-call-final = <0x0 0xe 0x13 0x12 0x18000>;
};

&mt6681_pmic {
	mediatek,i2c-driving = <11 11>;
};

&i2c5 {
	clock-frequency = <400000>;

/* AWINIC AW882XX mono Smart PA */

aw882xx_smartpa_0: aw882xx_smartpa@36 {
	 compatible = "awinic,aw882xx_smartpa";
	 reg = <0x36>;
	 #address-cells = <1>;
	 #size-cells = <0>;
	 #sound-dai-cells = <0>;
	 sync-load = <0>;
	 sound-channel = <0>;
	 reset-gpio = <&pio 119 0x1>;
	 aw-re-min = <5500>;
	 aw-re-max= <8500>;
	 aw-re-default = <6000>;
	 aw-f0-min = <200>;
	 aw-f0-max = <1000>;
	 aw-f0-default = <900>;
	 //aw-cali-mode = "none";
	 need_f0_cali = <1>;
	 spin-mode = "dsp_spin";
	 monitor-mode = "hal_monitor";
	 que_dela_work = <1>;
	 fade-flag = <0>;
	 need-add-bus-id = <1>;
	 default-chip-id = <0x2113>;
	 status = "okay";
};

aw882xx_smartpa_1: aw882xx_smartpa@35 {
	 compatible = "awinic,aw882xx_smartpa";
	 reg = <0x35>;
	 #address-cells = <1>;
	 #size-cells = <0>;
	 #sound-dai-cells = <0>;
	 sync-load = <0>;
	 sound-channel = <2>;
	 reset-gpio = <&pio 118 0x1>;
	 aw-re-min = <5500>;
	 aw-re-max= <8500>;
	 aw-re-default = <6000>;
	 aw-f0-min = <200>;
	 aw-f0-max = <1000>;
	 aw-f0-default = <900>;
	 //aw-cali-mode = "none";
	 need_f0_cali = <1>;
	 spin-mode = "dsp_spin";
	 monitor-mode = "hal_monitor";
	 que_dela_work = <1>;
	 fade-flag = <0>;
	 need-add-bus-id = <1>;
	 default-chip-id = <0x2113>;
	 status = "okay";
};

aw882xx_smartpa_2: aw882xx_smartpa@34 {
	 compatible = "awinic,aw882xx_smartpa";
	 reg = <0x34>;
	 #address-cells = <1>;
	 #size-cells = <0>;
	 #sound-dai-cells = <0>;
	 sync-load = <0>;
	 sound-channel = <4>;
	 reset-gpio = <&pio 120 0x1>;
	 aw-re-min = <5500>;
	 aw-re-max= <8500>;
	 aw-re-default = <6000>;
	 aw-f0-min = <200>;
	 aw-f0-max = <1000>;
	 aw-f0-default = <900>;
	 //aw-cali-mode = "none";
	 need_f0_cali = <1>;
	 spin-mode = "dsp_spin";
	 monitor-mode = "hal_monitor";
	 que_dela_work = <1>;
	 fade-flag = <0>;
	 need-add-bus-id = <1>;
	 default-chip-id = <0x2113>;
	 cali-disable = <1>;
	 status = "okay";
};

};

&i2c6 {
	clock-frequency = <400000>;

/* AWINIC AW882XX mono Smart PA */

aw882xx_smartpa_3: aw882xx_smartpa@34 {
	 compatible = "awinic,aw882xx_smartpa";
