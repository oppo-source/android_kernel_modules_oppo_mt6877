#include <dt-bindings/clock/mt6899-clk.h>
#include <dt-bindings/thermal/thermal.h>

&pmic_adc {
	vin5_100k {
		channel = <AUXADC_VIN5>;
		pures = <ADC_PURES_100K>;
	};
};

&mt6368_adc {
	vin2-open {
		channel = <AUXADC_VIN2>;
		pures = <ADC_PURES_100K>;
	};
};

